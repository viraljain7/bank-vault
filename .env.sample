# ============================================================
# VaultBank environment configuration
# Copy to .env (root) and server/.env. Never commit real secrets.
# ============================================================

NODE_ENV=development

# Express server port
PORT=5000

# MongoDB connection string
MONGODB_URI=

# Clerk (https://dashboard.clerk.com -> API Keys)
# CLERK_SECRET_KEY is used only on the backend.
CLERK_PUBLISHABLE_KEY=

CLERK_SECRET_KEY=


# Browser-facing Clerk publishable key (client/.env.local)
VITE_CLERK_PUBLISHABLE_KEY=

# Server-side AES-256-GCM key (hex, 64 chars = 32 bytes).
# Used for layered defense-in-depth encryption of vault unlock key wrappers.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Allowed frontend origins (space separated). Strict CORS for production.
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Optional controls
TRUST_PROXY=0
LOG_LEVEL=info