# ============================================================
# VaultBank API server configuration
# Copy to server/.env. Never commit real secrets.
# ============================================================

NODE_ENV=development

# Express server port
PORT=5000

# MongoDB connection string
MONGODB_URI=




# Clerk backend secret (https://dashboard.clerk.com -> API Keys)
CLERK_SECRET_KEY=

# Allowed frontend origin(s), comma-separated. Used for CORS.
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Server-side AES-256-GCM key (hex, 64 chars = 32 bytes).
# Layered defense-in-depth for vault unlock key wrappers.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Set to 1 behind a reverse proxy (Heroku/Render/Railway/Mongo Atlas proxy)
TRUST_PROXY=0

# pino log level: trace | debug | info | warn | error
LOG_LEVEL=info